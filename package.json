{
  "name": "sivakucs",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "predev": "npm run assets",
    "dev": "next dev",
    "prebuild": "npm run assets",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "build:sandbox": "node scripts/build-sandbox.mjs",
    "test:e2e": "playwright test",
    "check:cheerpj": "node scripts/check-cheerpj.mjs",
    "verify": "tsx scripts/verify.ts",
    "content": "tsx scripts/build-content.ts",
    "typecheck": "next typegen && tsc --noEmit",
    "assets": "npm run content && node scripts/copy-monaco.mjs"
  },
  "dependencies": {
    "@monaco-editor/react": "^4.7.0",
    "marked": "^18.2.0",
    "monaco-editor": "^0.57.0",
    "next": "16.4.6",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "@tailwindcss/turbopack": "4.3.3",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.6",
    "tailwindcss": "4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^5"
  },
  "allowScripts": {
    "esbuild": false
  }
}
